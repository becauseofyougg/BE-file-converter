# ---------------------------------------------------------------------------
# Every key the stack reads. Each service validates only its own section at
# boot (Joi, in `apps/<service>/src/config`) and refuses to start on a bad one.
#
# Locally, `docker compose` passes the per-service values; this file is what you
# copy to `.env` when running a service directly with `npm run start:dev:<app>`.
# ---------------------------------------------------------------------------

# --- shared by every service ----------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
HEALTH_CHECK_ENABLED=true
# SERVICE_NAME and PORT differ per service — see the sections below.

# --- infrastructure --------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Database per service: identity / conversion / notification. The gateway has none.
POSTGRES_DB=identity
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_UPLOADS=uploads
S3_BUCKET_RESULTS=results
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL=300

# --- api-gateway -----------------------------------------------------------
SERVICE_NAME=api-gateway
PORT=3000
COOKIE_SECRET=change-me
# Comma-separated allow-list. Never "*" — the API uses credentialed requests.
CORS_ORIGINS=http://localhost:5174,http://localhost:4200,http://localhost:8080
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# --- identity-service ------------------------------------------------------
# SERVICE_NAME=identity-service
# PORT=3001
JWT_SECRET=change-me-to-at-least-32-characters-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Email confirmation, switchable per scenario — docs/REGISTRATION.md §2
AUTH_CONFIRM_REGISTRATION=true
AUTH_CONFIRM_PASSWORD_RESET=true
AUTH_CONFIRM_LOGIN=false
AUTH_CONFIRM_METHOD=otp

# --- conversion-service ----------------------------------------------------
# SERVICE_NAME=conversion-service
# PORT=3002
# Which family this replica consumes: image | document | av | data.
# It decides both the queue it binds to and the binaries its image must ship.
CONVERSION_FAMILY=image
CONVERSION_TIMEOUT_MS=600000
CONVERSION_MAX_SOURCE_BYTES=104857600
CONVERSION_RESULT_TTL_HOURS=24

# --- notification-service --------------------------------------------------
# SERVICE_NAME=notification-service
# PORT=3003
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=no-reply@file-converter.local
APP_PUBLIC_URL=http://localhost:3000
