{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../../",
  "testEnvironment": "node",
  "testRegex": "apps/api-gateway/test/.*\\.e2e-spec\\.ts$",
  "setupFiles": ["<rootDir>/apps/api-gateway/test/setup-env.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": [
      "ts-jest",
      { "tsconfig": { "allowJs": true, "module": "commonjs", "target": "es2022" } }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!content-disposition/)"],
  "moduleNameMapper": {
    "^@core$": "<rootDir>/libs/core/src",
    "^@core/(.*)$": "<rootDir>/libs/core/src/$1",
    "^@contracts$": "<rootDir>/libs/contracts/src",
    "^@contracts/(.*)$": "<rootDir>/libs/contracts/src/$1",
    "^@storage$": "<rootDir>/libs/storage/src",
    "^@storage/(.*)$": "<rootDir>/libs/storage/src/$1",
    "^@obs$": "<rootDir>/libs/observability/src",
    "^@obs/(.*)$": "<rootDir>/libs/observability/src/$1"
  }
}
