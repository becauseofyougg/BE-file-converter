// The `identity` database. One schema per service — nobody else reads these
// tables, which is what keeps the services independently deployable.
//
// See docs/REGISTRATION.md §7.

generator client {
  provider        = "prisma-client-js"
  // Generated into node_modules so a bare import resolves the same from `src`
  // and from the compiled output in `dist`, which a relative path would not.
  output          = "../../../node_modules/@prisma-clients/identity"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"

  // Read by the Prisma **CLI** only — migrations, studio, diff. The running
  // service passes its own `DATABASE_URL` to the client constructor instead
  // (see src/database/prisma.service.ts), because in a container that is the
  // one variable compose sets.
  //
  // They are separate names on purpose: three schemas share one root `.env`
  // during development, so a single `DATABASE_URL` would point the identity
  // CLI at whichever database was configured last.
  url = env("IDENTITY_DATABASE_URL")

  extensions = [citext]
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// citext, so the uniqueness the application promises is the uniqueness the
  /// database enforces. Normalising in code alone leaves two paths to the same
  /// account the moment one call site forgets to lower-case.
  email String @unique(map: "uq_users_email") @db.Citext

  /// argon2id, with its parameters encoded in the string. Never logged.
  passwordHash String @map("password_hash")

  /// What the user calls themselves. Nullable and not unique: it is a label,
  /// not an identifier — `email` is the identifier, and making two people pick
  /// different names would be a rule with no purpose behind it.
  displayName String? @map("display_name") @db.VarChar(64)

  /// Null until the address is proven. Registration with confirmation off sets
  /// it immediately — the only difference between the two modes, as far as
  /// this table is concerned.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  /// Consecutive failed passwords, reset on any success. Counted per account
  /// rather than per IP: a password-spraying botnet rotates addresses, and the
  /// thing being attacked is this account.
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")

  /// Set when the count crosses the threshold; login is refused until it
  /// passes. Null when not locked.
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)

  /// An object-storage key in the `uploads` bucket, never a URL: the bucket is
  /// private, so what the client receives is a short-lived presigned link the
  /// gateway mints per request. Storing a URL would either make the object
  /// public or bake an expiry into a column. Null until a photo is uploaded —
  /// and nothing uploads one yet, see docs/USER-PROFILE.md §5.
  photoKey String? @map("photo_key") @db.VarChar(512)

  /// Set when the account has been erased — docs/ACCOUNT-DELETION.md.
  ///
  /// The row survives its own deletion, emptied of everything personal. It has
  /// to: `conversion_jobs` lives in another database and carries `user_id` with
  /// no foreign key to enforce anything, so dropping the row here would leave
  /// every job and every audit line pointing at nothing. Null means a live
  /// account, and every path that reads a user treats non-null as absent.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// Set when a session is actually issued, not merely when the password is
  /// accepted — a login waiting on a confirmation has not happened yet.
  /// Null until the first one. Sortable in the admin list, which is what makes
  /// "who has not been here for a year" answerable.
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  verificationTokens VerificationToken[]
  roles              UserRoleAssignment[]

  /// The admin list sorts by these and pages with `id` as the tie-break, so the
  /// index has to carry the tie-break too — otherwise the sort is stable and
  /// the *scan* is not, and a cursor can skip or repeat a row.
  @@index([createdAt, id], map: "idx_users_created_at_id")
  @@index([lastLoginAt, id], map: "idx_users_last_login_id")
  @@map("users")
}

/// A role a user holds. Many-to-many because docs/RBAC.md §1.1 makes a user
/// "the bearer of one or more roles", and the evaluator unions their grants.
model UserRoleAssignment {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: deleting a role that people still hold would
  /// silently strip their access. §1.3.2 requires the refusal instead.
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@id([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role")
  @@map("user_roles")
}

/// A named role. The set is data, not code — that is the point of the whole
/// feature: an administrator adds one without a deploy.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique(map: "uq_roles_name") @db.VarChar(64)
  description String? @db.VarChar(255)

  /// Seeded roles the application relies on existing (USER, ADMIN). They can
  /// be granted and revoked like any other, but not renamed or deleted —
  /// otherwise a bad afternoon in the admin UI locks everyone out.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  grants Grant[]
  users  UserRoleAssignment[]

  @@map("roles")
}

/// A protected resource and the actions it defines — `users` with
/// `['read', 'create', 'delete']`. A grant may hand out all of them or a subset.
model Permission {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique(map: "uq_permissions_name") @db.VarChar(64)

  /// The closed set of actions this resource understands. An action outside it
  /// can never be granted, so a grant naming one is rejected at write time.
  actions String[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  grants Grant[]

  @@map("permissions")
}

/// Role → permission, optionally narrowed to some of its actions.
model Grant {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  /// Empty means every action the permission defines. Stored empty rather than
  /// expanded, so an action added to the permission later is picked up without
  /// revisiting every grant that meant "all of them".
  actions String[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// §1.3.4: one grant per (role, permission) — a second one would make the
  /// effective actions depend on which row was read first.
  @@unique([roleId, permissionId], map: "uq_grants_role_permission")
  @@map("grants")
}

/// One row is one *challenge*: the thing a user is currently being asked to
/// prove. Resending rotates the secret inside the same row rather than opening
/// a second one, so the challengeId the client received at registration stays
/// valid and there is never more than one live code per user and type.
model VerificationToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type String @db.VarChar(32)

  /// The opaque handle the client quotes back. Separate from `id` so the
  /// primary key never travels, and non-guessable so it cannot be used to
  /// probe for other people's challenges.
  challengeId String @unique(map: "uq_verification_tokens_challenge_id") @default(uuid()) @map("challenge_id") @db.Uuid

  /// SHA-256 hex of the code or link token — never the value itself.
  tokenHash String @map("token_hash") @db.Char(64)

  method String @db.VarChar(8)

  /// Only for `type = 'email_change'`: the address being claimed. It lives on
  /// the challenge rather than being re-sent at confirmation time, so the
  /// address that was proved is necessarily the address that gets applied —
  /// otherwise a code mailed to one address could be quoted back alongside
  /// another. Null for every other type.
  newEmail String? @map("new_email") @db.Citext

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  /// Wrong guesses against the current secret. Capped per challenge in the
  /// database rather than by the IP throttler — an attacker rotating IPs would
  /// otherwise have unlimited attempts at a six-digit code.
  attempts    Int      @default(0)
  resendCount Int      @default(0) @map("resend_count")
  lastSentAt  DateTime @default(now()) @map("last_sent_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, type], map: "idx_verification_tokens_user_type")
  // A magic link arrives as the secret alone, so the hash is the lookup key.
  @@index([tokenHash], map: "idx_verification_tokens_hash")
  @@map("verification_tokens")
}

// There is deliberately no `refresh_tokens` model. docs/AUTHORIZATION.md §1
// forbids a server-side record of a refresh token — no allowlist, no denylist,
// no session row — so the refresh token is a self-contained JWT and this schema
// has nothing to say about it. The table that used to be here was dropped in
// `20260922160000_drop_refresh_tokens`.

/// A domain event written in the same transaction as the state change it
/// describes, and published to the broker afterwards by the relay. Publishing
/// inline would mean either a broker call inside an open transaction or one
/// after commit that is lost if the process dies in between.
model OutboxMessage {
  id            String   @id @default(uuid()) @db.Uuid
  eventName     String   @map("event_name") @db.VarChar(64)
  payload       Json
  correlationId String   @map("correlation_id") @db.VarChar(64)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)

  /// Null while the relay still owes the broker this message.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  attempts  Int      @default(0)
  lastError String?  @map("last_error")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("outbox")
}
