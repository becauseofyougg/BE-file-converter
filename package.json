{
  "name": "mnt",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:api-gateway && npm run build:identity-service && npm run build:conversion-service && npm run build:notification-service",
    "build:api-gateway": "nest build api-gateway",
    "build:identity-service": "nest build identity-service",
    "build:conversion-service": "nest build conversion-service",
    "build:notification-service": "nest build notification-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start api-gateway",
    "start:dev": "nest start api-gateway --watch",
    "start:dev:api-gateway": "nest start api-gateway --watch",
    "start:dev:identity-service": "nest start identity-service --watch",
    "start:dev:conversion-service": "nest start conversion-service --watch",
    "start:dev:notification-service": "nest start notification-service --watch",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:prod:api-gateway": "node dist/apps/api-gateway/apps/api-gateway/src/main",
    "start:prod:identity-service": "node dist/apps/identity-service/apps/identity-service/src/main",
    "start:prod:conversion-service": "node dist/apps/conversion-service/apps/conversion-service/src/main",
    "start:prod:notification-service": "node dist/apps/notification-service/apps/notification-service/src/main",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:create:identity": "npm run typeorm -- migration:create apps/identity-service/src/database/migrations/Migration",
    "migration:generate:identity": "npm run typeorm -- migration:generate apps/identity-service/src/database/migrations/Migration -d apps/identity-service/src/database/data-source.ts",
    "migration:run:identity": "npm run typeorm -- migration:run -d apps/identity-service/src/database/data-source.ts",
    "migration:revert:identity": "npm run typeorm -- migration:revert -d apps/identity-service/src/database/data-source.ts",
    "migration:show:identity": "npm run typeorm -- migration:show -d apps/identity-service/src/database/data-source.ts",
    "migration:create:conversion": "npm run typeorm -- migration:create apps/conversion-service/src/database/migrations/Migration",
    "migration:generate:conversion": "npm run typeorm -- migration:generate apps/conversion-service/src/database/migrations/Migration -d apps/conversion-service/src/database/data-source.ts",
    "migration:run:conversion": "npm run typeorm -- migration:run -d apps/conversion-service/src/database/data-source.ts",
    "migration:revert:conversion": "npm run typeorm -- migration:revert -d apps/conversion-service/src/database/data-source.ts",
    "migration:show:conversion": "npm run typeorm -- migration:show -d apps/conversion-service/src/database/data-source.ts",
    "migration:create:notification": "npm run typeorm -- migration:create apps/notification-service/src/database/migrations/Migration",
    "migration:generate:notification": "npm run typeorm -- migration:generate apps/notification-service/src/database/migrations/Migration -d apps/notification-service/src/database/data-source.ts",
    "migration:run:notification": "npm run typeorm -- migration:run -d apps/notification-service/src/database/data-source.ts",
    "migration:revert:notification": "npm run typeorm -- migration:revert -d apps/notification-service/src/database/data-source.ts",
    "migration:show:notification": "npm run typeorm -- migration:show -d apps/notification-service/src/database/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.5",
    "@nestjs/microservices": "^11.2.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.13",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "joi": "^18.0.2",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "typeorm-transactional": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps",
      "<rootDir>/libs"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@core$": "<rootDir>/libs/core/src",
      "^@core/(.*)$": "<rootDir>/libs/core/src/$1",
      "^@contracts$": "<rootDir>/libs/contracts/src",
      "^@contracts/(.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@storage$": "<rootDir>/libs/storage/src",
      "^@storage/(.*)$": "<rootDir>/libs/storage/src/$1",
      "^@obs$": "<rootDir>/libs/observability/src",
      "^@obs/(.*)$": "<rootDir>/libs/observability/src/$1"
    },
    "collectCoverageFrom": [
      "apps/**/*.(t|j)s",
      "libs/**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/main.ts",
      "!**/*.entity.ts",
      "!**/*.dto.ts",
      "!**/database/migrations/**",
      "!**/data-source.ts",
      "!**/index.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
